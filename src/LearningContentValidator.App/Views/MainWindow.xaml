<Window x:Class="LearningContentValidator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:LearningContentValidator.App.Converters"
        xmlns:vm="clr-namespace:LearningContentValidator.App.ViewModels"
        mc:Ignorable="d"
        Title="Learning Content Validator" 
        Height="780" Width="1050"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:ByteSizeConverter x:Key="ByteSizeConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <!-- Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Metric Tile Style -->
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Folder Selection & Action Controls -->
            <RowDefinition Height="Auto" />
            <!-- 2: Progress & Status -->
            <RowDefinition Height="Auto" />
            <!-- 3: Summary Statistics -->
            <RowDefinition Height="Auto" />
            <!-- 4: Filter & Results DataGrid -->
            <RowDefinition Height="*" />
            <!-- 5: Selected Item Details Drawer -->
            <RowDefinition Height="140" />
            <!-- 6: Footer Actions (Export) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Learning Content Validator" 
                       FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Text="Pre-release verification of digital course packages against enterprise compliance rules" 
                       FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
        </StackPanel>

        <!-- 1: Folder Selection & Action Controls -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Folder:" VerticalAlignment="Center" 
                           FontWeight="Medium" Margin="0,0,12,0" Foreground="#334155" />

                <TextBox Grid.Column="1" Text="{Binding SelectedFolderPath, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Padding="8,6" Background="#F8FAFC"
                         BorderBrush="#CBD5E1" BorderThickness="1" />

                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseFolderCommand}" 
                        Padding="14,6" Margin="8,0,0,0" Background="#F1F5F9" BorderBrush="#CBD5E1"
                        Cursor="Hand" FontWeight="Medium" />

                <Button Grid.Column="3" Content="Start Validation" Command="{Binding StartValidationCommand}" 
                        Padding="16,6" Margin="8,0,0,0" Background="#2563EB" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />

                <Button Grid.Column="4" Content="Cancel" Command="{Binding CancelValidationCommand}" 
                        Padding="14,6" Margin="8,0,0,0" Background="#EF4444" Foreground="White"
                        BorderThickness="0" FontWeight="Medium" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- 2: Progress & Status -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <Grid Margin="0,0,0,4">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontWeight="Medium" />
                <TextBlock HorizontalAlignment="Right" Foreground="#475569" FontWeight="SemiBold"
                           Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" />
            </Grid>
            <ProgressBar Height="8" Minimum="0" Maximum="100" 
                         Value="{Binding ProgressPercentage, Mode=OneWay}" 
                         IsIndeterminate="{Binding IsIndeterminate}" 
                         Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0" />
        </StackPanel>

        <!-- 3: Summary Statistics Cards -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Files Scanned -->
                <Border Grid.Column="0" Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Files Scanned" FontSize="11" Foreground="#64748B" />
                        <TextBlock Text="{Binding Summary.TotalFiles}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                    </StackPanel>
                </Border>

                <!-- Valid Files -->
                <Border Grid.Column="1" Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Valid Files" FontSize="11" Foreground="#16A34A" />
                        <TextBlock Text="{Binding Summary.ValidFiles}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" />
                    </StackPanel>
                </Border>

                <!-- Invalid Files -->
                <Border Grid.Column="2" Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Invalid Files" FontSize="11" Foreground="#DC2626" />
                        <TextBlock Text="{Binding Summary.InvalidFiles}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" />
                    </StackPanel>
                </Border>

                <!-- Warnings -->
                <Border Grid.Column="3" Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Warnings" FontSize="11" Foreground="#D97706" />
                        <TextBlock Text="{Binding Summary.WarningCount}" FontSize="18" FontWeight="Bold" Foreground="#D97706" />
                    </StackPanel>
                </Border>

                <!-- Errors -->
                <Border Grid.Column="4" Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Errors" FontSize="11" Foreground="#DC2626" />
                        <TextBlock Text="{Binding Summary.ErrorCount}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" />
                    </StackPanel>
                </Border>

                <!-- Duration -->
                <Border Grid.Column="5" Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Duration" FontSize="11" Foreground="#64748B" />
                        <TextBlock Text="{Binding Summary.FormattedDuration}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 4: Filter & Results DataGrid -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter Bar -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,10,0" Foreground="#475569" />
                        <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All"
                                Padding="10,3" Margin="2,0" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" />
                        <Button Content="Errors Only" Command="{Binding SetFilterCommand}" CommandParameter="Errors Only"
                                Padding="10,3" Margin="2,0" Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" Cursor="Hand" />
                        <Button Content="Warnings Only" Command="{Binding SetFilterCommand}" CommandParameter="Warnings Only"
                                Padding="10,3" Margin="2,0" Background="#FEF3C7" Foreground="#92400E" BorderThickness="0" Cursor="Hand" />
                        <Button Content="Valid Only" Command="{Binding SetFilterCommand}" CommandParameter="Valid Only"
                                Padding="10,3" Margin="2,0" Background="#DCFCE7" Foreground="#166534" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Border>

                <!-- DataGrid Results Table -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredResults}" 
                          SelectedItem="{Binding SelectedResult}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          Background="White" BorderThickness="0" RowHeight="32"
                          SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <!-- File Name -->
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="2*" />

                        <!-- File Type -->
                        <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="90" />

                        <!-- Size -->
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="90" />

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                            Background="{Binding StatusText, Converter={StaticResource StatusToBrushConverter}}">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Errors Count -->
                        <DataGridTextColumn Header="Errors" Binding="{Binding ErrorCount}" Width="70" />

                        <!-- Warnings Count -->
                        <DataGridTextColumn Header="Warnings" Binding="{Binding WarningCount}" Width="80" />

                        <!-- Full Path -->
                        <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 5: Selected Item Details Drawer -->
        <Border Grid.Row="5" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Details for: " FontWeight="SemiBold" Foreground="#334155" />
                    <TextBlock Text="{Binding SelectedResult.FileName, FallbackValue='(Select a row above to view rule details)'}" 
                               FontWeight="Bold" Foreground="#0F172A" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedResult.Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8,4" CornerRadius="4"
                                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="6,2" CornerRadius="3" Margin="0,0,8,0"
                                                Background="{Binding Severity, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding Severity}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Message}" Foreground="#475569" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 6: Footer Actions (Export) -->
        <Border Grid.Row="6" Padding="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export Report (JSON)" Command="{Binding ExportJsonReportCommand}" 
                        Padding="14,7" Margin="0,0,8,0" Background="#0284C7" Foreground="White"
                        BorderThickness="0" FontWeight="Medium" Cursor="Hand" />

                <Button Content="Export Report (CSV)" Command="{Binding ExportCsvReportCommand}" 
                        Padding="14,7" Background="#0D9488" Foreground="White"
                        BorderThickness="0" FontWeight="Medium" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

